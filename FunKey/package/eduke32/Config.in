config BR2_PACKAGE_EDUKE32
	bool "eduke32"
	default y
	select BR2_PACKAGE_SDL
	select BR2_PACKAGE_SDL_MIXER
	select BR2_PACKAGE_LIBMIKMOD
	select BR2_PACKAGE_LIBOGG
	help
	  Duke Nukem 3D port for the FunKey S, packaged as an OPK
	  with the shareware episode.

	  https://github.com/mollusk-os/eduke32
